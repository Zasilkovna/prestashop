includes:
	- phpstan-baseline.neon
parameters:
	phpVersion:
		min: 70100
		max: 80100
	fileExtensions:
		- php
	level: 5
	strictRules:
		allRules: true
	treatPhpDocTypesAsCertain: false
	dynamicConstantNames:
		- _PS_MODE_DEV_
		- _PACKETERY_DEBUG_LOG_
	ignoreErrors:
		# Stub inaccuracy: our display(): void overrides FrontController::display(), declared @return bool in the stub.
		# Cannot be fixed in code — the PS Validator forbids returning a value from display().
		-
			identifier: method.childReturnType
			paths:
				- ../packetery/controllers/front/checkout.php
				- ../packetery/controllers/front/cron.php
		# DateMalformedStringException exists from PHP 8.3; the analysed range starts at 7.1,
		# so the class is unknown there and PHPStan flags the @throws as non-Throwable.
		# The warning appears only when PHPStan itself runs on a PHP 8.3+ binary, where the class is reflectable.
		-
			identifier: throws.notThrowable
			paths:
				- ../packetery/libs/Log/LogRepository.php
	bootstrapFiles:
	paths:
		- ../packetery
	scanDirectories:
		- ../vendor/stancer/php-stubs-prestashop/stubs
